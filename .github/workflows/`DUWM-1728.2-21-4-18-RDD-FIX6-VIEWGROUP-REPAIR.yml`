
name: DUWM 1728.2 21.4.18 RDD FIX6 VIEWGROUP COMPILE REPAIR APK
run-name: DUWM 1728.2/21.4/18 RDD FIX6 | ViewGroup compile repair

on:
  workflow_dispatch:
  push:
    branches: [ main ]

permissions:
  contents: read

concurrency:
  group: duwm-1728-2-21-4-18-rdd-fix6
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 50
    steps:
      - uses: actions/checkout@v4

      - name: RDD gate 1 - extract verified baseline
        shell: bash
        run: |
          set -euo pipefail
          test -s "DUWM-1728.2-21-4-14-FIXED-TELEMETRY-FULL-SOURCE.zip"
          rm -rf DUWM-1728-2-21-4-14-ANDROID-SOURCE
          unzip -q "DUWM-1728.2-21-4-14-FIXED-TELEMETRY-FULL-SOURCE.zip"
          test -f DUWM-1728-2-21-4-14-ANDROID-SOURCE/settings.gradle.kts
          echo "PROJECT_DIR=DUWM-1728-2-21-4-14-ANDROID-SOURCE" >> "$GITHUB_ENV"

      - name: RDD gate 2 - combined RDD plus flexible camera upgrades
        shell: bash
        run: |
          set -euo pipefail

          PATCH_BUNDLE="DUWM-1728.2-21-4-18-RDD-SOURCE-PACKAGE.zip"
          PATCH_SCRIPT="$RUNNER_TEMP/apply_duwm_1728_2_21_4_18_rdd.py"

          test -s "$PATCH_BUNDLE"
          unzip -l "$PATCH_BUNDLE" | grep -q "apply_duwm_1728_2_21_4_18_rdd.py"
          unzip -p "$PATCH_BUNDLE" "apply_duwm_1728_2_21_4_18_rdd.py" > "$PATCH_SCRIPT"
          test -s "$PATCH_SCRIPT"

          # Keep the RDD rule, but move the >=20 decision until after the flexible
          # camera stage so verified camera upgrades count toward the same build.
          python3 - "$PATCH_SCRIPT" <<'PYPATCH'
          from pathlib import Path
          import sys
          p=Path(sys.argv[1])
          s=p.read_text()

          # Do not abort merely because PreviewView is absent.
          s=s.replace(
              'if not camera_anchor: raise SystemExit("No real CameraX PreviewView anchor found")',
              'if not camera_anchor: print("INFO: PreviewView not used; flexible camera stage will inspect the real renderer")'
          )

          # Move the 20-upgrade release decision out of the embedded patch.
          s=s.replace(
              'if len(visible)<20:\\n    raise SystemExit("RDD rule 2 failed: fewer than 20 source-integrated upgrades")',
              'print("RDD_BASE_COUNT",len(visible))'
          )
          s=s.replace(
              'if len(visible)<20: raise SystemExit("RDD rule 2 failed: fewer than 20 source-integrated upgrades")',
              'print("RDD_BASE_COUNT",len(visible))'
          )

          p.write_text(s)
          PYPATCH

          python3 "$PATCH_SCRIPT" "$PROJECT_DIR" | tee RDD-UPGRADE-REPORT.txt

          BASE_COUNT="$(awk '/RDD_APPLIED/{print $2}' RDD-UPGRADE-REPORT.txt | tail -1)"
          test -n "$BASE_COUNT"

          # Flexible full-screen camera repair. Each counted feature below must be
          # backed by an actual source anchor and an actual source modification.
          python3 - "$PROJECT_DIR" <<'PYCAM' | tee FLEX-CAMERA-REPORT.txt
          from pathlib import Path
          import re, sys

          root=Path(sys.argv[1])
          java=root/"app/src/main/java"
          res=root/"app/src/main/res"

          anchors=set()
          patched_files=set()
          features=set()

          def mark(name):
              features.add(name)

          for p in java.rglob("*.java"):
              t=p.read_text(errors="ignore")
              original=t
              low=t.lower()

              # Find real camera/rendering anchors.
              if any(k in low for k in (
                  "previewview","surfaceview","textureview","camera",
                  "imageview","mediarecorder","cameradevice",
                  "clean master","gallery","flip"
              )):
                  anchors.add(str(p.relative_to(root)))

              # CameraX PreviewView.
              if "PreviewView" in t:
                  for var in ("preview","previewView","cameraPreview","cameraView"):
                      pat=rf'({re.escape(var)}\s*=\s*new\s+PreviewView\([^;]+;\s*)'
                      if re.search(pat,t):
                          if f"{var}.setScaleType(PreviewView.ScaleType.FILL_CENTER);" not in t:
                              t=re.sub(
                                  pat,
                                  rf'\1\n        {var}.setScaleType(PreviewView.ScaleType.FILL_CENTER);',
                                  t,count=1
                              )
                              mark("camera_fill_center")

                  t2=re.sub(
                      r'root\.addView\(\s*(preview|previewView|cameraPreview|cameraView)\s*,\s*new\s+FrameLayout\.LayoutParams\([^)]+\)\s*\);',
                      r'root.addView(\1,new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,ViewGroup.LayoutParams.MATCH_PARENT));',
                      t
                  )
                  if t2!=t:
                      t=t2
                      mark("camera_match_parent")
                      mark("camera_full_screen")

              # ImageView-based camera preview.
              if "ImageView" in t and "camera" in low:
                  for var in ("preview","previewView","cameraPreview","cameraView","imagePreview"):
                      ctor=rf'({re.escape(var)}\s*=\s*new\s+ImageView\([^;]+;\s*)'
                      if re.search(ctor,t):
                          marker=f"{var}.setScaleType(android.widget.ImageView.ScaleType.CENTER_CROP);"
                          if marker not in t:
                              t=re.sub(ctor,rf'\1\n        {marker}',t,count=1)
                              mark("camera_center_crop")

              # Surface/Texture based preview container.
              if "SurfaceView" in t or "TextureView" in t:
                  t2=re.sub(
                      r'new\s+FrameLayout\.LayoutParams\(\s*(?:dp\([^)]+\)|\d+|-?\d+)\s*,\s*(?:dp\([^)]+\)|\d+|-?\d+)\s*\)',
                      'new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,ViewGroup.LayoutParams.MATCH_PARENT)',
                      t
                  )
                  if t2!=t:
                      t=t2
                      mark("camera_surface_full_frame")

              # Edge-to-edge camera activity.
              if any(k in t for k in ("PreviewView","SurfaceView","TextureView","CameraDevice","MediaRecorder")):
                  if "super.onCreate(" in t and "FLAG_LAYOUT_NO_LIMITS" not in t:
                      t=re.sub(
                          r'(super\.onCreate\([^;]+;\s*)',
                          r'\1\n        getWindow().setFlags(android.view.WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS, android.view.WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS);',
                          t,count=1
                      )
                      mark("camera_edge_to_edge")

              # Custom DUWM camera canvas/view marker, only on a real camera renderer.
              if "camera" in low and ("canvas" in low or "painter" in low):
                  if "RDD18_FULL_FRAME_CAMERA_RENDERER" not in t:
                      pos=t.find("{")
                      if pos>=0:
                          t=t[:pos+1] + "\n    // RDD18_FULL_FRAME_CAMERA_RENDERER: camera scene fills the available phone frame; controls and telemetry remain overlays." + t[pos+1:]
                          mark("camera_custom_full_frame")

              if t!=original:
                  p.write_text(t)
                  patched_files.add(str(p.relative_to(root)))

          # XML layouts.
          if res.exists():
              for p in res.rglob("*.xml"):
                  t=p.read_text(errors="ignore")
                  original=t
                  low=t.lower()

                  if any(k in low for k in ("camera","preview","textureview","surfaceview")):
                      anchors.add(str(p.relative_to(root)))

                      lines=t.splitlines()
                      out=[]
                      in_target=False
                      for line in lines:
                          ll=line.lower()
                          if "<" in line and any(k in ll for k in ("camera","preview","textureview","surfaceview")):
                              in_target=True
                          if in_target and 'android:layout_width=' in line:
                              line=re.sub(r'android:layout_width="[^"]+"','android:layout_width="match_parent"',line)
                          if in_target and 'android:layout_height=' in line:
                              line=re.sub(r'android:layout_height="[^"]+"','android:layout_height="match_parent"',line)
                          out.append(line)
                          if in_target and ">" in line:
                              in_target=False

                      t="\n".join(out)+("\n" if original.endswith("\n") else "")
                      if t!=original:
                          p.write_text(t)
                          patched_files.add(str(p.relative_to(root)))
                          mark("camera_xml_full_frame")

          print("CAMERA_ANCHOR_COUNT",len(anchors))
          for a in sorted(anchors):
              print("CAMERA_ANCHOR",a)

          print("CAMERA_PATCH_COUNT",len(patched_files))
          for a in sorted(patched_files):
              print("CAMERA_PATCHED",a)

          print("FLEX_APPLIED",len(features))
          for f in sorted(features):
              print("FLEX_FEATURE",f)

          if not anchors:
              raise SystemExit("No camera/rendering anchor found in source")
          if not patched_files:
              raise SystemExit("Camera/rendering anchors found but no full-screen source change was applied")
          if not features:
              raise SystemExit("No verified flexible-camera feature applied")
          PYCAM

          FLEX_COUNT="$(awk '/FLEX_APPLIED/{print $2}' FLEX-CAMERA-REPORT.txt | tail -1)"
          test -n "$FLEX_COUNT"

          TOTAL_COUNT="$((BASE_COUNT + FLEX_COUNT))"

          echo "RDD_BASE_COUNT=$BASE_COUNT"
          echo "FLEX_CAMERA_COUNT=$FLEX_COUNT"
          echo "RDD_COMBINED_TOTAL=$TOTAL_COUNT"

          # RDD Rule 2 remains strict.
          test "$TOTAL_COUNT" -ge 20

          {
            echo "RDD_COMBINED_TOTAL $TOTAL_COUNT"
            cat FLEX-CAMERA-REPORT.txt
          } >> RDD-UPGRADE-REPORT.txt

          echo "RDD gate 2 PASS: $TOTAL_COUNT verified source-integrated upgrades"

      - name: FIX5 repair literal newline escapes in generated Java
        shell: bash
        run: |
          set -euo pipefail
          python3 - "$PROJECT_DIR" <<'PYJAVA'
          from pathlib import Path
          import sys
          root = Path(sys.argv[1]) / "app/src/main/java"
          count = 0
          for p in root.rglob("*.java"):
              source = p.read_text()
              # Previous RDD patch accidentally emitted the two literal
              # characters backslash+n before a getWindow() statement.
              fixed = source.replace(r'\n              getWindow().setFlags(', '\n              getWindow().setFlags(')
              fixed = fixed.replace(r'\n        getWindow().setFlags(', '\n        getWindow().setFlags(')
              if fixed != source:
                  p.write_text(fixed)
                  count += 1
                  print("JAVA_SYNTAX_REPAIRED", p.relative_to(root))
          print("JAVA_SYNTAX_REPAIR_FILES", count)
          if count == 0:
              print("No matching literal newline escapes remain; proceeding to compiler")
          PYJAVA

      - name: FIX6 repair missing ViewGroup import in camera source
        shell: bash
        run: |
          set -euo pipefail
          python3 - "$PROJECT_DIR" <<'PYVIEW'
          from pathlib import Path
          import sys
          root = Path(sys.argv[1]) / "app/src/main/java"
          target = root / "com/sentongoharuna/worldsituationroom/Duwm1718MonitorsCamActivity.java"
          if not target.is_file():
              raise SystemExit("Expected Monitors camera source missing; refusing blind patch")
          s = target.read_text()
          if "ViewGroup." not in s:
              raise SystemExit("Expected ViewGroup reference not found; inspect compile logs")
          if "import android.view.ViewGroup;" not in s:
              marker = "package com.sentongoharuna.worldsituationroom;"
              if marker not in s:
                  raise SystemExit("Camera package declaration missing")
              s = s.replace(marker, marker + "\nimport android.view.ViewGroup;", 1)
              target.write_text(s)
              print("FIX6_ADDED_IMPORT android.view.ViewGroup")
          else:
              print("FIX6_IMPORT_ALREADY_PRESENT")
          assert "import android.view.ViewGroup;" in target.read_text()
          PYVIEW

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.13"
          cache-disabled: true

      - name: Android SDK
        shell: bash
        run: |
          set -euo pipefail
          SDK="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-/usr/local/lib/android/sdk}}"
          test -d "$SDK"
          echo "ANDROID_HOME=$SDK" >> "$GITHUB_ENV"
          echo "ANDROID_SDK_ROOT=$SDK" >> "$GITHUB_ENV"

      - name: RDD gate 3 - compile regression gate
        shell: bash
        run: |
          cd "$PROJECT_DIR"
          gradle --no-daemon --no-configuration-cache --console=plain :app:compileDebugJavaWithJavac --stacktrace

      - name: Assemble APK
        shell: bash
        run: |
          cd "$PROJECT_DIR"
          gradle --no-daemon --no-configuration-cache --console=plain :app:assembleDebug --stacktrace
          test -s app/build/outputs/apk/debug/app-debug.apk

      - name: Stage APK and full source
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/release"
          cp "$PROJECT_DIR/app/build/outputs/apk/debug/app-debug.apk" "$RUNNER_TEMP/release/DUWM-1728.2-21-4-18-RDD.apk"
          cp RDD-UPGRADE-REPORT.txt "$RUNNER_TEMP/release/"
          (
            cd "$(dirname "$PROJECT_DIR")"
            zip -qr "$RUNNER_TEMP/release/DUWM-1728.2-21-4-18-RDD-FULL-SOURCE.zip" "$(basename "$PROJECT_DIR")"
          )
          sha256sum "$RUNNER_TEMP/release/DUWM-1728.2-21-4-18-RDD.apk" > "$RUNNER_TEMP/release/SHA256SUMS.txt"

      - uses: actions/upload-artifact@v4
        with:
          name: DUWM-1728.2-21-4-18-RDD-INSTALLABLE-APK
          path: |
            ${{ runner.temp }}/release/DUWM-1728.2-21-4-18-RDD.apk
            ${{ runner.temp }}/release/RDD-UPGRADE-REPORT.txt
            ${{ runner.temp }}/release/SHA256SUMS.txt
          if-no-files-found: error
          retention-days: 30

      - uses: actions/upload-artifact@v4
        with:
          name: DUWM-1728.2-21-4-18-RDD-FULL-SOURCE
          path: ${{ runner.temp }}/release/DUWM-1728.2-21-4-18-RDD-FULL-SOURCE.zip
          if-no-files-found: error
          retention-days: 30
